# Biến môi trường của Exam-Practice.
# Sao chép file này thành .env rồi điền giá trị thật. File .env KHÔNG được commit (đã có trong .gitignore).
# Trên server: đặt các biến này làm biến môi trường thật thay vì dùng file .env.

# ---------- PostgreSQL ----------
DB_URL=jdbc:postgresql://localhost:5432/exam_practice
DB_USERNAME=postgres
DB_PASSWORD=

# ---------- JWT ----------
# Chuỗi ngẫu nhiên tối thiểu 256 bit. Tạo bằng lệnh: openssl rand -base64 48
# Mỗi môi trường (máy cá nhân, staging, production) dùng một secret riêng.
JWT_SECRET=
# Thời gian sống của access token, tính bằng mili giây (mặc định 24 giờ)
JWT_EXPIRATION_MS=86400000

# ---------- CORS ----------
# Địa chỉ giao diện (giao thức + tên miền + cổng, không có dấu / ở cuối), cách nhau bằng dấu phẩy.
# Để trống khi giao diện và API chung một địa chỉ hoặc giao diện đi qua proxy; khi đó không bật CORS.
# Đã điền thì phải điền đủ mọi địa chỉ giao diện: địa chỉ không có trong danh sách sẽ bị từ chối.
# Ví dụ React chạy bằng Vite trên máy cá nhân: http://localhost:5173
CORS_ALLOWED_ORIGINS=
